# Server
PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET=change_this_to_a_strong_secret_key_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_this_to_another_strong_secret_key
JWT_REFRESH_EXPIRES_IN=7d

# Database (à adapter selon ton ORM)
DATABASE_URL=postgresql://user:password@localhost:5432/mydb

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
