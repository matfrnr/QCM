@baseUrl = http://localhost:3000/api/v1
@authToken = {{login.response.body.data.accessToken}}

### ---------------------------------------------------
### PRÉREQUIS : AUTHENTIFICATION (Obligatoire pour tester)
### ---------------------------------------------------

# @name register
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "student3@neon.com",
  "password": "Password123!",
  "name": "Etu Neon"
}

###
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "student3@neon.com",
  "password": "Password123!"
}

### ---------------------------------------------------
### ROUTES DE LA CONSIGNE
### ---------------------------------------------------

### 1. Route de santé
GET {{baseUrl}}/health


### 2. POST /qcms : Crée un QCM avec les questions
# @name createQcm
POST {{baseUrl}}/qcms
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "title": "Quiz Express et Prisma",
  "question1": {
    "text": "Que signifie API ?",
    "propositions": [
      { "text": "Application Programming Interface", "isCorrect": true },
      { "text": "Advanced Program Integration", "isCorrect": false },
      { "text": "Automated Process Interaction", "isCorrect": false }
    ]
  },
  "question2": {
    "text": "Quel port est utilisé par défaut dans cet exercice ?",
    "propositions": [
      { "text": "8080", "isCorrect": false },
      { "text": "3000", "isCorrect": true }
    ]
  }
}

### Sauvegarde automatique de l'ID du QCM créé
@qcmId = {{createQcm.response.body.data.id}}


### 3. GET /qcms : Liste tous les QCMs
GET {{baseUrl}}/qcms
Authorization: Bearer {{authToken}}


### 4. GET /qcms/:id : Récupère un QCM par son id
GET {{baseUrl}}/qcms/{{qcmId}}
Authorization: Bearer {{authToken}}


### 5. GET /qcms/:id/question : Récupère la prochaine question d'un QCM
# @name getNextQuestion
GET {{baseUrl}}/qcms/{{qcmId}}/question
Authorization: Bearer {{authToken}}

### Sauvegarde automatique des IDs pour répondre
@questionId = {{getNextQuestion.response.body.data.id}}
@propositionId = {{getNextQuestion.response.body.data.propositions[0].id}}


### 6. POST /qcms/:id/response : Soumet une réponse
POST {{baseUrl}}/qcms/{{qcmId}}/response
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "questionId": "{{questionId}}",
  "propositionId": "{{propositionId}}"
}


### 7. GET /qcms/:id/result : Récupère le résultat d'un QCM (score)
GET {{baseUrl}}/qcms/{{qcmId}}/result
Authorization: Bearer {{authToken}}


### 8. DELETE /qcms/:id : Supprime un QCM et les questions associées
DELETE {{baseUrl}}/qcms/{{qcmId}}
Authorization: Bearer {{authToken}}